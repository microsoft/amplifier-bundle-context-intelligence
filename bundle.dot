// Context Intelligence — a bundle that records and analyzes what happens inside
// Amplifier AI sessions, so people can see which tools ran, how agents were used,
// and what each step cost. Provides graph queries, session navigation, and analytics.
digraph context_intelligence {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="Context Intelligence — See Inside Your AI Sessions\nRecords, explores, and analyzes what Amplifier sessions actually do"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="fbf7b96d634315e64a60f47d45ae240a00240cb8ba4c2e3f26aa5128be1cd551"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    root_context_intelligence [label="Context Intelligence (this repository)\ncontext-intelligence v0.1.0\n0 tools · 0 agents\n~98 tok aggregate", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", penwidth=2]

    subgraph cluster_behaviors {
        label="Behaviors — bundled capabilities you can turn on"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        beh_context_intelligence_analytics_behavior [label="Session Analytics & Exploration\n2 tools · 1 ctx\n~2723 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
        beh_context_intelligence_logging_behavior [label="Session Activity Logging\n1 tools\n~498 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
        beh_context_intelligence_behavior [label="Core Session Awareness\n~187 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
    }

    subgraph cluster_agents {
        label="Agents — specialist assistants for specific jobs"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        agt_context_intelligence_design_facilitator [label="Design Facilitator\nGuides tool-design conversations\n~187 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_context_intelligence_tool_designer [label="Tool Designer\nDesigns new analysis tools\n~198 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_graph_analyst [label="Graph Analyst\nAnswers questions from session data\n~543 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_session_navigator [label="Session Navigator\nWalks through past session histories\n~366 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
    }

    subgraph cluster_modules {
        label="Modules — the tools and recorders that do the work"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        mod_hook_context_intelligence [label="Session Recorder\nCaptures activity as it happens", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
        mod_tool_blob_read [label="Large-Data Reader\nOpens big stored payloads", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
        mod_tool_context_intelligence_upload [label="Session Uploader\nSends session data to the store", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
        mod_tool_graph_query [label="Session Graph Query\nSearches the recorded data", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
    }

    subgraph cluster_context {
        label="Context Files — background reading for the agents"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        ctx_context_intelligence_awareness_md [label="How sessions are tracked\ncontext-intelligence-awareness.md\n~1355 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Legend — what the colors mean"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="root bundle", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="behavior", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
        leg_agent [label="agent", shape=box, fillcolor="#c8e6c9", style="filled,rounded", fontsize=9]
        leg_module [label="module", shape=box, fillcolor="#bbdefb", style="filled,rounded", fontsize=9]
        leg_provider [label="provider", shape=box, fillcolor="#e0e0e0", style="filled,rounded", fontsize=9]
        leg_context [label="context", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="standalone", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="experiment", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="ext+cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="ext+no-cost", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="Token estimates: ~4 chars/token\nSolid border = local (counted)\nDashed + red = external, hidden cost (not counted)\nDashed + muted = external, no cost\nExcludes: sub-session costs, runtime-dynamic", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]

    ext_githttps___github_com_microsoft_amplifier_foundation_main [label="amplifier-foundation\nShared base it builds on\n(external, cost)", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2]

    root_context_intelligence -> ext_githttps___github_com_microsoft_amplifier_foundation_main [style=dashed]
    root_context_intelligence -> beh_context_intelligence_behavior [label="composes"]
    beh_context_intelligence_analytics_behavior -> agt_graph_analyst [label="owns"]
    beh_context_intelligence_analytics_behavior -> agt_session_navigator [label="owns"]
    beh_context_intelligence_analytics_behavior -> ctx_context_intelligence_awareness_md [style=dotted, color=purple]
    beh_context_intelligence_logging_behavior -> mod_hook_context_intelligence [label="uses", penwidth=0.8]
}