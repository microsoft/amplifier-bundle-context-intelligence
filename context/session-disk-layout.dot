// Session Disk Layout — File Structure Tree
// Context-Intelligence Bundle
//
// Shows the on-disk directory structure for session logging:
// ~/.amplifier/projects/{project-slug}/sessions/{session-id}/context-intelligence/
//
// Render: dot -Tsvg session-disk-layout.dot -o session-disk-layout.svg

digraph SessionDiskLayout {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    nodesep=0.6;
    ranksep=0.8;
    pad=0.5;

    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    node [shape=folder, style=filled, penwidth=1.5];

    root [
        label="~/.amplifier/projects/",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    project_slug [
        label="{project-slug}/",
        fillcolor="#BBDEFB",
        color="#1565C0"
    ];

    sessions [
        label="sessions/",
        fillcolor="#90CAF9",
        color="#1565C0"
    ];

    session_id_a [
        label="{session-id-a}/",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    session_id_b [
        label="{session-id-b}/",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    ci_dir_a [
        label="context-intelligence/",
        fillcolor="#C8E6C9",
        color="#2E7D32"
    ];

    ci_dir_b [
        label="context-intelligence/",
        fillcolor="#C8E6C9",
        color="#2E7D32"
    ];

    node [shape=note, style=filled, penwidth=1];

    metadata_a [
        label="metadata.json\n─────────────────\nformat, version\nsession_id, parent_id\nstarted_at, ended_at\nstatus, working_dir\noptional agent/recipe fields",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    events_a [
        label="events.jsonl\n─────────────────\nOne JSON line per event.\nAppend-only log.\nFull sanitized event payload.",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    metadata_b [
        label="metadata.json",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    events_b [
        label="events.jsonl",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    root -> project_slug [color="#1565C0", penwidth=1.5];
    project_slug -> sessions [color="#1565C0", penwidth=1.5];
    sessions -> session_id_a [color="#2E7D32", penwidth=1.5];
    sessions -> session_id_b [color="#2E7D32", penwidth=1.5];
    session_id_a -> ci_dir_a [color="#2E7D32", penwidth=1.5];
    session_id_b -> ci_dir_b [color="#2E7D32", penwidth=1.5];
    ci_dir_a -> metadata_a [color="#F57F17", penwidth=1];
    ci_dir_a -> events_a [color="#F57F17", penwidth=1];
    ci_dir_b -> metadata_b [color="#F57F17", penwidth=1];
    ci_dir_b -> events_b [color="#F57F17", penwidth=1];

    {rank=same; session_id_a; session_id_b}
    {rank=same; ci_dir_a; ci_dir_b}
    {rank=same; metadata_a; events_a; metadata_b; events_b}
}
