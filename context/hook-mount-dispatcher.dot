// Hook Mount Dispatcher — Top-Level Decision Flow
// Context-Intelligence Bundle
//
// The top-level mount() dispatcher orchestrates both the always-on logging path
// and the conditional graph path. This diagram shows the full decision flow.
//
// Render: dot -Tsvg hook-mount-dispatcher.dot -o hook-mount-dispatcher.svg

digraph HookMountDispatcher {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    nodesep=0.8;
    ranksep=0.9;
    pad=0.5;

    // ─── Global defaults ─────────────────────────────────────────────
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // ─── Entry / Resolution nodes (blue) ─────────────────────────────
    node [shape=box, style="rounded,filled", penwidth=2];

    entry_mount [
        label="mount(coordinator)\n───────────────────\nEntry point called by Kernel",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    resolve_slug [
        label="resolve_slug\n───────────────────\nDetermine project slug\nfrom coordinator config",
        fillcolor="#BBDEFB",
        color="#1565C0"
    ];

    resolve_base [
        label="resolve_base\n───────────────────\nResolve base directory\n~/.amplifier/projects/{slug}",
        fillcolor="#90CAF9",
        color="#1565C0"
    ];

    // ─── Discovery node (yellow) ─────────────────────────────────────
    discover_events [
        label="discover_events\n───────────────────\nQuery coordinator for\nobservability.events\n(canonical + legacy channels)",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    // ─── Logging creation node (green) ───────────────────────────────
    create_logging [
        label="create_logging\n───────────────────\nALWAYS: Create LoggingHandler\npriority=100, all events\nflat JSONL to disk",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    // ─── Decision diamond (red) ──────────────────────────────────────
    node [shape=diamond, style=filled, penwidth=2];

    graph_decision [
        label="enable_graph\nAND\ngraph_stores?",
        fillcolor="#FFEBEE",
        color="#C62828",
        fontcolor="#C62828"
    ];

    // ─── Graph path nodes (indigo) ───────────────────────────────────
    node [shape=box, style="rounded,filled", penwidth=2];

    create_graph [
        label="create_graph\n───────────────────\nCreate GraphDataHook\npriority=90, MountFlow,\n7 handlers, Neo4jGraphStore",
        fillcolor="#E8EAF6",
        color="#283593"
    ];

    // ─── Skip node (grey) ────────────────────────────────────────────
    skip_graph [
        label="skip_graph\n───────────────────\nGraph path disabled.\nLogging-only mode.",
        fillcolor="#EEEEEE",
        color="#757575",
        fontcolor="#616161"
    ];

    // ─── Return node (blue) ──────────────────────────────────────────
    return_cleanup [
        label="return cleanup()\n───────────────────\nReturn combined cleanup\ncallable to Kernel",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    // ═══════════════════════════════════════════════════════════════════
    // ─── Transition edges ─────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    entry_mount -> resolve_slug [
        color="#1565C0",
        penwidth=2
    ];

    resolve_slug -> resolve_base [
        color="#1565C0",
        penwidth=2
    ];

    resolve_base -> discover_events [
        color="#F57F17",
        penwidth=2
    ];

    discover_events -> create_logging [
        label="  ALWAYS  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2
    ];

    create_logging -> graph_decision [
        color="#C62828",
        penwidth=2
    ];

    graph_decision -> create_graph [
        label="  YES  ",
        color="#283593",
        fontcolor="#283593",
        penwidth=2
    ];

    graph_decision -> skip_graph [
        label="  NO  ",
        color="#757575",
        fontcolor="#757575",
        penwidth=2
    ];

    create_graph -> return_cleanup [
        color="#1565C0",
        penwidth=2
    ];

    skip_graph -> return_cleanup [
        color="#1565C0",
        penwidth=2,
        style=dashed
    ];
}
