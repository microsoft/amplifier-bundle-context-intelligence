// GraphDataHook Mount Flow — 5-State Machine Diagram (Conditional Graph Path)
// Context-Intelligence Bundle
//
// This diagram covers the CONDITIONAL graph path only.
// The top-level dispatcher (see hook-mount-dispatcher.dot) decides whether
// this flow runs at all, based on enable_graph and graph_stores configuration.
//
// Render: dot -Tsvg hook-mount-registration-flow.dot -o hook-mount-registration-flow.svg
//         dot -Tpng hook-mount-registration-flow.dot -o hook-mount-registration-flow.png

digraph HookMountFlow {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    newrank=true;
    nodesep=0.8;
    ranksep=1.0;
    pad=0.5;

    // ─── Global defaults ───────────────────────────────────────────────────────────────────────────────────────────
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // ─── State nodes (gradient from light to dark as flow advances) ───
    node [shape=box, style="rounded,filled", penwidth=2];

    INIT [
        label="INIT\n─────────────────\nGraphDataHook instantiated.\nNeo4jGraphStore provided.\nNo state exists yet.",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    STATE_CREATED [
        label="STATE_CREATED\n─────────────────────────\nHookStateService ready.\nGraphState + HookConfig\ninitialized.",
        fillcolor="#BBDEFB",
        color="#1565C0"
    ];

    HANDLERS_INSTANTIATED [
        label="HANDLERS_INSTANTIATED\n──────────────────────────────\nAll 7 handlers constructed.\nclaimed_events set computed\nfrom 6 entity handlers.",
        fillcolor="#90CAF9",
        color="#1565C0"
    ];

    SPECIFIC_REGISTERED [
        label="SPECIFIC_REGISTERED\n──────────────────────────────\nAll 6 entity handlers registered\nfor their claimed events.",
        fillcolor="#42A5F5",
        color="#0D47A1",
        fontcolor="white"
    ];

    READY [
        label="READY\n──────────────────────────────\nHook fully mounted.\nEvery discovered non-excluded\nevent has exactly one handler.",
        fillcolor="#1E88E5",
        color="#0D47A1",
        fontcolor="white"
    ];

    // ─── Component records (side annotations) ─────────────────────────────────────────────────
    node [shape=record, style=filled, penwidth=1];

    HookStateService [
        label="{HookStateService|{graph: GraphState|config: HookConfig}}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    GraphState [
        label="{GraphState|get_node(node_id: str)\lget_edge(source, target, type)\lupsert_node(id, labels, props)\lupsert_edge(source, target, type, props)\l}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    SessionCursors [
        label="{SessionCursors|current_run_id\lcurrent_step_id\lrun_counter\lstep_counter\lprompt_preview\lparallel_groups\ltool_call_map\l|Managed by:\lHookStateService._cursors:\l  dict[str, SessionCursors]\l}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    HookConfig [
        label="{HookConfig|exclude_events: set[str]\lis_excluded(event) -> bool\l}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    // ─── Handler set record ───────────────────────────────────────────────────────────────────
    Handlers [
        label="{Entity Handlers (6)|SessionHandler → :Session\l|OrchestratorRunHandler → :OrchestratorRun, :Step:PromptStep\l|StepHandler → :Step:AssistantStep\l|RecipeStepHandler → :Step:RecipeStep\l|ToolExecutionHandler → :ToolExecution\l|EventHandler → :Event:\\{FullScope\\}\l}|{DefaultHandler|handled_events: \\{\\} (empty at construction)\lReceives unclaimed events at Phase 5\lDerives :Event:\\{DerivedFullScope\\} labels\l}",
        fillcolor="#FFF3E0",
        color="#E65100"
    ];

    // ─── Protocol note ────────────────────────────────────────────────────────────────────────────────────────────
    node [shape=note, style=filled, penwidth=1];

    ProtocolNote [
        label="EventHandler Protocol\n──────────────────────\nhandled_events: frozenset[str]\n__call__(event, data) → HookResult\nservices: HookStateService\n──────────────────────\nRuntime-checkable.\nNo inheritance.\nNote: DefaultHandler uses\nmutable set[str] instead.",
        fillcolor="#F3E5F5",
        color="#6A1B9A"
    ];

    InvariantNote [
        label="Key Invariant\n──────────────────────────\nEvery discovered non-excluded\nevent gets exactly ONE handler.\nNo duplicates. No gaps.",
        fillcolor="#FCE4EC",
        color="#AD1457"
    ];

    // ─── Design decision note ─────────────────────────────────────────────────────────────────────────────────────
    node [shape=note, style=filled, penwidth=1];

    DesignNote [
        label="Conscious Design Decision\n──────────────────────────────\nEvents are discovered once in mount()\nand passed down. MountFlow does not\nquery the coordinator independently.\nEliminates dual-discovery divergence risk.",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
    // ─── Transition edges (main flow) ─────────────────────────────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

    // Phase 1: INIT → STATE_CREATED
    INIT -> STATE_CREATED [
        label="  Create HookStateService\n  (GraphState + HookConfig)  ",
        color="#1565C0",
        fontcolor="#1565C0",
        penwidth=2
    ];

    // Phase 2: STATE_CREATED → HANDLERS_INSTANTIATED
    STATE_CREATED -> HANDLERS_INSTANTIATED [
        label="  Instantiate 7 handlers\n  (each receives HookStateService)\n  Aggregate claimed_events  ",
        color="#1565C0",
        fontcolor="#1565C0",
        penwidth=2
    ];

    // Phase 3: HANDLERS_INSTANTIATED → SPECIFIC_REGISTERED
    HANDLERS_INSTANTIATED -> SPECIFIC_REGISTERED [
        label="  Events arrive as parameter\n  from mount() via run(coordinator, events)\n  remaining = events − excluded\n  (HookConfig.is_excluded() applied here)\n  Then register entity handlers  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2
    ];

    // Phase 4: SPECIFIC_REGISTERED → READY
    SPECIFIC_REGISTERED -> READY [
        label="  unclaimed = remaining − claimed\n  For each unclaimed event:\n    register(event, default_handler)  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2
    ];

    // ─── Component association edges ─────────────────────────────────────────────────────────────────────────────

    HookStateService -> GraphState [
        style=dashed,
        color="#2E7D32",
        arrowhead=vee,
        label="  contains  "
    ];

    HookStateService -> HookConfig [
        style=dashed,
        color="#2E7D32",
        arrowhead=vee,
        label="  contains  "
    ];

    HookStateService -> SessionCursors [
        style=dashed,
        color="#2E7D32",
        arrowhead=vee,
        label="  manages (per session)  "
    ];

    INIT -> HookStateService [
        style=dotted,
        color="#66BB6A",
        arrowhead=none,
        constraint=false,
        label="  created at Phase 1  "
    ];

    STATE_CREATED -> Handlers [
        style=dotted,
        color="#FF9800",
        arrowhead=none,
        constraint=false,
        label="  created at Phase 2  "
    ];

    Handlers -> ProtocolNote [
        style=dotted,
        color="#9C27B0",
        arrowhead=none,
        constraint=false,
        label="  all conform to  "
    ];

    READY -> InvariantNote [
        style=dotted,
        color="#AD1457",
        arrowhead=none,
        constraint=false
    ];

    HANDLERS_INSTANTIATED -> DesignNote [
        style=dotted,
        color="#2E7D32",
        arrowhead=none,
        constraint=false
    ];

    // ─── Layout hints ─────────────────────────────────────────────────────────────────────────────────────────────

    // Main flow is vertical
    {rank=same; INIT}
    {rank=same; STATE_CREATED; HookStateService}
    {rank=same; HANDLERS_INSTANTIATED; Handlers; DesignNote}
    {rank=same; SPECIFIC_REGISTERED; ProtocolNote}
    {rank=same; READY; InvariantNote}
    {rank=same; GraphState; HookConfig; SessionCursors}
}
