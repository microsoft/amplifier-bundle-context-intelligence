// CompositeGraphStore — Fan-Out Write & First-Responder Read
// Context-Intelligence Bundle
//
// Shows how CompositeGraphStore dispatches writes to all backends (fan-out)
// and reads from the first backend that succeeds (first-responder).
//
// Render: dot -Tsvg composite-graph-store.dot -o composite-graph-store.svg

digraph CompositeGraphStore {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    nodesep=0.8;
    ranksep=1.0;
    pad=0.5;

    // ─── Global defaults ─────────────────────────────────────────────
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // ─── Caller ──────────────────────────────────────────────────────
    node [shape=box, style="rounded,filled", penwidth=2];

    handler_calls [
        label="Handler calls\n───────────────────\nGraphDataHook handlers\ninvoke store operations:\nupsert_node / upsert_edge /\nquery / get_node / get_edge",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    // ─── CompositeGraphStore cluster ─────────────────────────────────
    subgraph cluster_composite {
        label="CompositeGraphStore";
        labelloc=t;
        style="rounded,filled";
        fillcolor="#F5F5F5";
        color="#424242";
        fontname="Helvetica";
        fontsize=13;
        penwidth=2;

        // ─── Write fan-out ───────────────────────────────────────────
        write_fan_out [
            label="write_fan_out\n───────────────────\nupsert_node / upsert_edge\nDispatched to ALL backends.\nErrors logged, never raised.\nBest-effort per store.",
            shape=box,
            style="rounded,filled",
            fillcolor="#E8F5E9",
            color="#2E7D32",
            penwidth=2
        ];

        // ─── Read first-responder ────────────────────────────────────
        read_first_responder [
            label="read_first_responder\n───────────────────\nquery / get_node / get_edge\nTry stores in priority order.\nReturn first successful result.\nFail only if ALL stores fail.",
            shape=box,
            style="rounded,filled",
            fillcolor="#FFF3E0",
            color="#E65100",
            penwidth=2
        ];
    }

    // ─── Backend stores (cylinder shapes) ────────────────────────────
    node [shape=cylinder, style=filled, penwidth=2];

    file_store [
        label="FileGraphStore\n(JSON files)",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    duckdb_store [
        label="DuckDB\n(SQL analytics)",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    neo4j_store [
        label="Neo4j\n(native graph)",
        fillcolor="#F3E5F5",
        color="#6A1B9A"
    ];

    // ─── Failure isolation note ──────────────────────────────────────
    node [shape=note, style=filled, penwidth=1];

    note_isolation [
        label="Failure Isolation\n─────────────────────\nEach backend runs independently.\nA failure in one store does NOT\naffect writes to other stores.\nErrors are logged as warnings.",
        fillcolor="#FFFDE7",
        color="#F57F17"
    ];

    // ═══════════════════════════════════════════════════════════════════
    // ─── Edges ────────────────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    handler_calls -> write_fan_out [
        label="  write ops  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2,
        lhead=cluster_composite
    ];

    handler_calls -> read_first_responder [
        label="  read ops  ",
        color="#E65100",
        fontcolor="#E65100",
        penwidth=2,
        lhead=cluster_composite
    ];

    // Fan-out write edges (all stores)
    write_fan_out -> file_store [
        label="  write  ",
        color="#2E7D32",
        penwidth=1.5
    ];

    write_fan_out -> duckdb_store [
        label="  write  ",
        color="#2E7D32",
        penwidth=1.5
    ];

    write_fan_out -> neo4j_store [
        label="  write  ",
        color="#2E7D32",
        penwidth=1.5
    ];

    // First-responder read edges (priority order)
    read_first_responder -> file_store [
        label="  try 1st  ",
        color="#E65100",
        penwidth=1.5
    ];

    read_first_responder -> duckdb_store [
        label="  try 2nd  ",
        color="#E65100",
        penwidth=1.5,
        style=dashed
    ];

    read_first_responder -> neo4j_store [
        label="  try 3rd  ",
        color="#E65100",
        penwidth=1.5,
        style=dashed
    ];

    // Note association
    note_isolation -> write_fan_out [
        style=dotted,
        color=grey,
        arrowhead=none,
        constraint=false
    ];
}
