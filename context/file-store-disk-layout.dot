digraph file_store_disk_layout {
    rankdir=TB;
    label="FileGraphStore — Forest-Aware On-Disk Layout\nTwo-level scoping: graph_store_root / graph_forest_name / {nodes,edges}. No per-session subdirectories.";
    labelloc=t;
    fontsize=14;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9];
    edge [fontname="Helvetica", fontsize=7];
    compound=true;

    // ── Config resolution chain ─────────────────────────────
    subgraph cluster_config {
        label="Configuration → Constructor";
        style=filled; fillcolor="#F8F9F9"; color="#BDC3C7";

        config [label="Hook Config (YAML)\n─────────────────────\ngraph_store:\n  type: file\n  graph_forest_name: my-project\n  config:\n    graph_store_root: ~/.amplifier/graphs"
                shape=note style=filled fillcolor="#D5F5E3"];

        factory [label="create_graph_store()\nstore_factory.py\n─────────────────────\nDefaults:\n  root = ~/.amplifier/graphs\n  forest = \"default\""
                 shape=box style=filled fillcolor="#FDEBD0"];

        constructor [label="FileGraphStore(\n  graph_store_root,\n  graph_forest_name\n)\n─────────────────────\n_location = root / forest\n_nodes_dir = _location / nodes\n_edges_dir = _location / edges"
                     shape=box style=filled fillcolor="#FDEBD0"];

        config -> factory [label="graph_forest_name\nis a top-level key"];
        factory -> constructor [label="two args"];
    }

    // ── Filesystem hierarchy ────────────────────────────────
    graph_root [label="~/.amplifier/graphs/\n(graph_store_root — shared)" shape=folder
                style=filled fillcolor="#F2F3F4"];

    constructor -> graph_root [style=dashed label="creates dirs\non init"];

    // ── Multiple forests (projects) ─────────────────────────
    subgraph cluster_forests {
        label="One subdirectory per forest (project)";
        style=filled; fillcolor="#FDFEFE"; color="#D5DBDB";

        forest_a [label="my-project/\n(graph_forest_name)" shape=folder
                  style=filled fillcolor="#EBF5FB"];
        forest_b [label="other-project/" shape=folder
                  style=filled fillcolor="#EBF5FB"];
        forest_default [label="default/\n(fallback)" shape=folder
                        style=filled fillcolor="#FADBD8"];
    }

    graph_root -> forest_a;
    graph_root -> forest_b;
    graph_root -> forest_default [style=dashed label="when no\nforest configured"];

    // ── Inside one forest: FLAT nodes/ ──────────────────────
    subgraph cluster_nodes {
        label="my-project/nodes/    (FLAT — all sessions, all time)";
        style=filled; fillcolor="#EBF5FB"; color="#AED6F1";

        sess_a [label="{session_A}.json\n─────────────────────\n{\n  \"id\": \"{session_A}\",\n  \"labels\": [\"Root\", \"Session\"],\n  \"properties\": {\n    \"started_at\": \"...\",\n    \"status\": \"completed\"\n  }\n}"
                shape=note style=filled fillcolor="#D6EAF8"];

        run_a [label="{session_A}__execution_start__{ts}.json\n─────────────────────\n{\n  \"id\": \"...\",\n  \"labels\": [\"OrchestratorRun\"],\n  \"properties\": { ... }\n}"
               shape=note style=filled fillcolor="#D5F5E3"];

        step_a [label="{session_A}__prompt_submit__{ts}.json\n─────────────────────\n{\n  \"id\": \"...\",\n  \"labels\": [\"PromptStep\", \"Step\"],\n  \"properties\": {\n    \"prompt_text\": \"...\"\n  }\n}"
                shape=note style=filled fillcolor="#FCF3CF"];

        tool_a [label="{session_A}__tool_pre__{ts}.json\n─────────────────────\n{\n  \"id\": \"...\",\n  \"labels\": [\"ToolExecution\"],\n  \"properties\": {\n    \"tool_name\": \"read_file\"\n  }\n}"
                shape=note style=filled fillcolor="#FADBD8"];

        sess_b [label="{session_B}.json\n─────────────────────\n(different session,\n same flat directory)"
                shape=note style=filled fillcolor="#D6EAF8"];

        child [label="{child_session_id}.json\n─────────────────────\n{\n  \"id\": \"{child_session_id}\",\n  \"labels\": [\"Session\", \"Subsession\"],\n  \"properties\": {\n    \"parent_id\": \"{session_A}\"\n  }\n}"
               shape=note style=filled fillcolor="#AED6F1"];

        evt [label="{session_A}__context_compaction__{ts}.json\n─────────────────────\n{\n  \"id\": \"...\",\n  \"labels\": [\"ContextCompaction\", \"Event\"],\n  \"properties\": { ... }\n}"
             shape=note style=filled fillcolor="#E8DAEF"];
    }

    // ── Inside one forest: FLAT edges/ ──────────────────────
    subgraph cluster_edges {
        label="my-project/edges/    (FLAT — all edges, all time)";
        style=filled; fillcolor="#FEF9E7"; color="#F9E79F";

        e_has_run [label="{session_A}==[HAS_RUN]==\n  {session_A}__execution_start__{ts}.json\n─────────────────────\n{ \"type\": \"HAS_RUN\",\n  \"properties\": { \"seq\": 1 } }"
                   shape=note style=filled fillcolor="#FDEBD0"];

        e_has_step [label="{..execution_start..}==[HAS_STEP]==\n  {..prompt_submit..}.json\n─────────────────────\n{ \"type\": \"HAS_STEP\",\n  \"properties\": { \"seq\": 0 } }"
                    shape=note style=filled fillcolor="#FDEBD0"];

        e_triggered [label="{..prompt_submit..}==[TRIGGERED]==\n  {..tool_pre..}.json\n─────────────────────\n{ \"type\": \"TRIGGERED\",\n  \"properties\": { \"seq\": 1 } }"
                     shape=note style=filled fillcolor="#FDEBD0"];

        e_spawned [label="{..tool_pre..}==[SPAWNED]==\n  {child_session_id}.json\n─────────────────────\n{ \"type\": \"SPAWNED\" }"
                   shape=note style=filled fillcolor="#FDEBD0"];

        e_subsess [label="{child_session_id}==[SUBSESSION_OF]==\n  {session_A}.json\n─────────────────────\n{ \"type\": \"SUBSESSION_OF\" }"
                   shape=note style=filled fillcolor="#FDEBD0"];

        e_has_event [label="{session_A}==[HAS_EVENT]==\n  {..context_compaction..}.json\n─────────────────────\n{ \"type\": \"HAS_EVENT\" }"
                     shape=note style=filled fillcolor="#FDEBD0"];
    }

    // ── Forest to directories ───────────────────────────────
    forest_a -> sess_a [lhead=cluster_nodes label="nodes/"];
    forest_a -> e_has_run [lhead=cluster_edges label="edges/"];

    // ── Logical graph topology ──────────────────────────────
    subgraph cluster_graph {
        label="Logical Graph Topology (one session's subgraph)";
        style=dashed; color="#5DADE2";

        g_sess [label="Session\n(Root)" shape=ellipse style=filled fillcolor="#D6EAF8"];
        g_run [label="Orchestrator\nRun" shape=ellipse style=filled fillcolor="#D5F5E3"];
        g_step [label="Step\n(PromptStep)" shape=ellipse style=filled fillcolor="#FCF3CF"];
        g_tool [label="Tool\nExecution" shape=ellipse style=filled fillcolor="#FADBD8"];
        g_child [label="Session\n(Subsession)" shape=ellipse style=filled fillcolor="#AED6F1"];
        g_evt [label="Event" shape=ellipse style=filled fillcolor="#E8DAEF"];

        g_sess -> g_run [label="HAS_RUN" color="#2E86C1" fontcolor="#2E86C1"];
        g_run -> g_step [label="HAS_STEP" color="#27AE60" fontcolor="#27AE60"];
        g_step -> g_tool [label="TRIGGERED" color="#E67E22" fontcolor="#E67E22"];
        g_tool -> g_child [label="SPAWNED" color="#8E44AD" fontcolor="#8E44AD"];
        g_child -> g_sess [label="SUBSESSION_OF" color="#8E44AD" fontcolor="#8E44AD" style=dashed];
        g_sess -> g_evt [label="HAS_EVENT" color="#95A5A6" fontcolor="#95A5A6"];
    }

    // ── Legend ───────────────────────────────────────────────
    legend [shape=plaintext label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" BGCOLOR="#F8F9F9">
        <TR><TD COLSPAN="2"><B>Forest Scoping Model</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Project isolation:</B></TD>
            <TD ALIGN="LEFT">graph_store_root / graph_forest_name (one subdir per project)</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Session isolation:</B></TD>
            <TD ALIGN="LEFT">NONE — filename prefix only, not a directory</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Cross-forest:</B></TD>
            <TD ALIGN="LEFT">FileGraphStore: own forest only. DuckDB: graph_forest_name="*"</TD></TR>
        <TR><TD COLSPAN="2"> </TD></TR>
        <TR><TD COLSPAN="2"><B>ID Generation Rules</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Session nodes:</B></TD>
            <TD ALIGN="LEFT">raw session_id (UUID)</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Other nodes:</B></TD>
            <TD ALIGN="LEFT">{session_id}__{event_name}__{epoch_ms}</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Edge files:</B></TD>
            <TD ALIGN="LEFT">{source_id}==[{EDGE_TYPE}]=={target_id}</TD></TR>
        <TR><TD COLSPAN="2"> </TD></TR>
        <TR><TD COLSPAN="2"><B>Shell Navigation</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>List forests:</B></TD>
            <TD ALIGN="LEFT">ls ~/.amplifier/graphs/</TD></TR>
        <TR><TD ALIGN="LEFT"><B>List sessions:</B></TD>
            <TD ALIGN="LEFT">ls {forest}/nodes/ | grep -v '__'</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Scope to session:</B></TD>
            <TD ALIGN="LEFT">ls {forest}/nodes/ | grep "^{session_id}"</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Outgoing edges:</B></TD>
            <TD ALIGN="LEFT">ls {forest}/edges/ | grep "^{node_id}=="</TD></TR>
        <TR><TD ALIGN="LEFT"><B>Incoming edges:</B></TD>
            <TD ALIGN="LEFT">ls {forest}/edges/ | grep "=={node_id}.json$"</TD></TR>
        <TR><TD COLSPAN="2"> </TD></TR>
        <TR><TD COLSPAN="2"><B>Edge Types (8 total)</B></TD></TR>
        <TR><TD ALIGN="LEFT">HAS_RUN</TD>    <TD ALIGN="LEFT">Session → OrchestratorRun</TD></TR>
        <TR><TD ALIGN="LEFT">HAS_STEP</TD>   <TD ALIGN="LEFT">OrchestratorRun → Step</TD></TR>
        <TR><TD ALIGN="LEFT">NEXT</TD>        <TD ALIGN="LEFT">Step → Step (sequential)</TD></TR>
        <TR><TD ALIGN="LEFT">TRIGGERED</TD>   <TD ALIGN="LEFT">Step → ToolExecution</TD></TR>
        <TR><TD ALIGN="LEFT">PARALLEL_WITH</TD><TD ALIGN="LEFT">ToolExecution ↔ ToolExecution</TD></TR>
        <TR><TD ALIGN="LEFT">SPAWNED</TD>     <TD ALIGN="LEFT">ToolExecution → Session (child)</TD></TR>
        <TR><TD ALIGN="LEFT">SUBSESSION_OF</TD><TD ALIGN="LEFT">Session → Session (parent)</TD></TR>
        <TR><TD ALIGN="LEFT">HAS_EVENT</TD>   <TD ALIGN="LEFT">any → Event</TD></TR>
        </TABLE>
    >];
}
