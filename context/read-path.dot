digraph read_path {
    rankdir=LR;
    label="GraphStore Read Path (Dual Source)\nHandlers see latest state (buffer-first). Analysis sees flushed state (backing store only).";
    labelloc=t;
    fontsize=14;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9];
    edge [fontname="Helvetica", fontsize=7];

    // Callers
    handler_read [label="Handler\nget_node()\nget_edge()"
                  shape=box];
    analysis [label="Analysis Tool\nexecute_query()\nCypher\nforest-scoped"
              shape=box style=filled fillcolor="#E8DAEF"];

    // Stores
    buffer [label="In-Memory Buffer\n(latest state)"
            shape=cylinder style=filled fillcolor="#D4E6F1"];
    neo4j [label="Backing Store\n(Neo4j)"
           shape=cylinder style=filled fillcolor="#D5F5E3"];

    // Read paths
    handler_read -> buffer [label="check first"];
    buffer -> neo4j [label="fallback if\nnot in buffer"
                     style=dashed];

    analysis -> neo4j [label="direct\nCypher queries"];

    // Notes
    note_handler [label="Handlers see latest state\n(buffer + Neo4j merged)"
                  shape=note style=filled fillcolor="#FDEBD0"];
    note_analysis [label="Analysis sees flushed state\n(Neo4j only, post-flush)\nNote: Cypher analysis is\nNeo4j only"
                   shape=note style=filled fillcolor="#FDEBD0"];

    note_forest [label="Forest filtering rules:\nNone \u2192 own forest\nexplicit \u2192 that forest\n'*' \u2192 cross-forest"
                 shape=note style=filled fillcolor="#FDEBD0"];

    handler_read -> note_handler [style=invis];
    analysis -> note_analysis [style=invis];
    analysis -> note_forest [style=invis];
}
