digraph prompt_submit_handler {
    rankdir=TB;
    label="prompt:submit Handler — PromptStep Creation\nCreates Step:PromptStep node and stores on SessionCursors\nEdges deferred to execution:start (OrchestratorRun creation)";
    labelloc=t;
    fontsize=14;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9];
    edge [fontname="Helvetica", fontsize=7];

    // Entry
    event_arrives [label="prompt:submit\narrives" shape=oval];

    // Extract
    extract [label="Extract\nsession_id, timestamp,\nprompt from data"
             shape=box style=filled fillcolor="#D4E6F1"];

    // Validate session exists
    validate_session [label="Retrieve Session node\nawait get_node(session_id)"
                      shape=box style=filled fillcolor="#D4E6F1"];
    session_missing [label="ERROR\nSession node not found\nfor session_id\nlog.error()"
                     shape=octagon style=filled fillcolor="#FF8A80"];
    error_exit [label="return\nHookResult(continue)\nno graph mutations"
                shape=oval style=filled fillcolor="#FADBD8"];

    // Get or create cursors
    get_cursors [label="Get SessionCursors\nservices.get_cursors(\n  session_id\n)"
                  shape=box style=filled fillcolor="#D4E6F1"];

    // Increment counters
    update_counters [label="Update Cursors\ncursors.run_counter++\ncursors.step_counter = 0"
                      shape=box style=filled fillcolor="#FCF3CF"];

    // Generate node ID
    gen_node_id [label="Generate node_id\nmake_node_id(\n  session_id,\n  'prompt:submit',\n  timestamp\n)\ne.g. abc__prompt_submit__1709683200123"
                 shape=box style=filled fillcolor="#D5F5E3"];

    // Create PromptStep
    create_step [label="upsert_node(\n  node_id,\n  labels={Step, PromptStep},\n  properties={\n    iteration: 0,\n    prompt_text: data.prompt,\n    prompt_preview: data.prompt[:200],\n    occurred_at: timestamp,\n    session_id: session_id\n  }\n)"
                 shape=box style=filled fillcolor="#E8DAEF"];

    // Store on cursors
    store_cursors [label="Store on Cursors\ncursors.current_step_id = node_id\ncursors.prompt_preview = prompt[:200]"
                    shape=box style=filled fillcolor="#FCF3CF"];

    // Exit
    done [label="return\nHookResult(continue)" shape=oval];

    // Note: no edges created
    no_edges_note [label="NOTE: No edges created here.\nHAS_STEP (Run→PromptStep)\nis created by execution:start\nwhen OrchestratorRun node\nis assembled."
                    shape=note style=filled fillcolor="#FFFDE7"];

    // Flow
    event_arrives -> extract;
    extract -> validate_session;
    validate_session -> session_missing [label="None"];
    session_missing -> error_exit;
    validate_session -> get_cursors [label="exists"];
    get_cursors -> update_counters;
    update_counters -> gen_node_id;
    gen_node_id -> create_step;
    create_step -> store_cursors [label="cursor ops AFTER\nnode creation"];
    store_cursors -> done;

    // Annotation link
    store_cursors -> no_edges_note [style=dotted color=gray arrowhead=none constraint=false];
}
