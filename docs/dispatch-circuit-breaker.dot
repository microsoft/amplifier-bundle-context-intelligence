// Dispatch Circuit Breaker — Queue Worker + _dispatch_to_server + Client Lifecycle
// Context-Intelligence Bundle — LoggingHandler
//
// Shows the full bounded dispatch flow with auto-recovery retry-in-place:
// - enqueue path in __call__ (bounded queue + worker startup)
// - _dispatch_to_server internal logic (classify, DEGRADED/PERMANENT, backoff retry)
// - client lifecycle (_client=None -> lazy create -> reuse -> aclose on close())
//
// UPDATED MODEL (auto-recovery): The one-way _enabled latch is removed.
// Dispatch is NEVER permanently disabled. On transient failure the worker holds
// the in-flight event and retries with capped full-jitter backoff until success
// or session end. Permanent failures (403/400/413/422) are skipped (loud log)
// and the worker advances to the next event.
//
// Color coding:
//   blue   (#E3F2FD / #1565C0) — entry / exit nodes
//   red    (#FFEBEE / #C62828) — threshold / permanent-skip nodes
//   yellow (#FFF8E1 / #F57F17) — conditional / decision diamonds + DEGRADED state
//   green  (#E8F5E9 / #2E7D32) — success paths / client creation
//   orange (#FFF3E0 / #E65100) — failure paths / overflow
//   purple (#EDE7F6 / #673AB7) — auth header
//
// Render: dot -Tsvg dispatch-circuit-breaker.dot -o dispatch-circuit-breaker.svg

digraph DispatchCircuitBreaker {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    nodesep=0.7;
    ranksep=0.9;
    pad=0.5;

    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    subgraph cluster_dispatch {
        label="Bounded dispatch flow";
        style=filled;
        fillcolor="#FAFAFA";
        color="#B0BEC5";
        fontsize=12;
        fontname="Helvetica Bold";

        node [shape=box, style="rounded,filled", penwidth=2];

        entry [
            label="__call__ enqueue path\n─────────────────────\n_enqueue_dispatch(event, data)\nput_nowait() into bounded queue\nspawn shared worker if needed",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        queue_full [
            label="queue full\n─────────────────────\ndrop NEWEST (durable in events.jsonl)\nbump counter\nloud rate-limited log naming\nthe REAL storage path; NOT disabled",
            fillcolor="#FFF3E0",
            color="#E65100"
        ];

        worker_entry [
            label="dispatch worker dequeues\n─────────────────────\n_dispatch_worker()\nserializes POSTs\none event at a time",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        node [shape=diamond, style=filled, penwidth=1.5];

        check_client [
            label="_client is None\nor is_closed?",
            fillcolor="#FFF8E1",
            color="#F57F17",
            fontcolor="#F57F17"
        ];

        node [shape=box, style="rounded,filled", penwidth=1.5];

        create_client [
            label="create _client\n─────────────────────\nhttpx.AsyncClient(\n  timeout=Timeout(\n    connect=0.5,\n    write=_dispatch_timeout,\n    read=3.0,\n    pool=0.5\n  ),\n  limits=Limits(max_connections=1,\n    max_keepalive_connections=1)\n)",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        node [shape=box, style="rounded,filled", penwidth=1.5];

        build_auth_header [
            label="build auth header\n──────────────────────────────────\nstrategy.headers()\ncache hit  →  Bearer <cached_token>  (~0.002 ms)\nmiss  →  az refresh  (~487–913 ms,  ≤ once / ~67 min)\nSee docs/auth-flow.dot for cache detail.",
            fillcolor="#EDE7F6",
            color="#673AB7"
        ];

        post [
            label="POST {server_url}/events\n─────────────────────\npayload = {\n  \"event\": event,\n  \"workspace\": _workspace,\n  \"idempotency_key\": deterministic_hash,\n  \"data\": sanitized_data\n}\nclient.post(..., json=payload)\nresponse.raise_for_status()",
            fillcolor="#E0F7FA",
            color="#00838F"
        ];

        node [shape=diamond, style=filled, penwidth=1.5];

        check_result [
            label="2xx response?",
            fillcolor="#FFF8E1",
            color="#F57F17",
            fontcolor="#F57F17"
        ];

        node [shape=box, style="rounded,filled", penwidth=1.5];

        on_success [
            label="on_success\n─────────────────────\n_consecutive_failures = 0\n_degraded_warned = False\nreset backoff; queue keeps draining",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        on_failure [
            label="on_failure\n─────────────────────\n_consecutive_failures += 1\nclassify: TRANSIENT or PERMANENT\n_last_status = status_code",
            fillcolor="#FFF3E0",
            color="#E65100"
        ];

        node [shape=diamond, style=filled, penwidth=2];

        check_threshold [
            label="transient?",
            fillcolor="#FFEBEE",
            color="#C62828",
            fontcolor="#C62828"
        ];

        node [shape=box, style="rounded,filled", penwidth=2];

        degraded [
            label="DEGRADED — hold in-flight event,\nfull-jitter backoff, retry SAME event\n(never disabled)\n─────────────────────\n_consecutive_failures >= threshold:\nemit DEGRADED notice once/episode",
            fillcolor="#FFF8E1",
            color="#F57F17"
        ];

        sleep_backoff [
            label="sleep backoff\n─────────────────────\nawait asyncio.sleep(\n  full_jitter(backoff_initial,\n    backoff_max, attempt)\n)",
            fillcolor="#FFF8E1",
            color="#F57F17"
        ];

        permanent_skip [
            label="PERMANENT — loud rate-limited log,\nskip event, advance\n─────────────────────\n403 / 400 / 413 / 422:\nlog once (rate-limited), task_done, advance",
            fillcolor="#FFEBEE",
            color="#C62828"
        ];

        done [
            label="done\n─────────────────────\nworker iteration completes\nlocal JSONL is the\ndurable record",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        entry -> worker_entry [penwidth=2];
        entry -> queue_full [
            label="  put_nowait fails  ",
            color="#E65100",
            fontcolor="#E65100",
            penwidth=1.5
        ];

        queue_full -> done [penwidth=1.5, color="#E65100"];

        worker_entry -> check_client [penwidth=1.5];

        check_client -> create_client [
            label="  Yes  ",
            color="#2E7D32",
            fontcolor="#2E7D32",
            penwidth=1.5
        ];

        check_client -> build_auth_header [
            label="  No (reuse)  ",
            color="#00838F",
            fontcolor="#00838F",
            penwidth=1.5
        ];

        create_client -> build_auth_header [penwidth=1.5];
        build_auth_header -> post [penwidth=1.5, color="#673AB7"];
        post -> check_result [penwidth=1.5];

        check_result -> on_success [
            label="  2xx (DELIVERED)  ",
            color="#2E7D32",
            fontcolor="#2E7D32",
            penwidth=1.5
        ];
        check_result -> on_failure [
            label="  exception /\n  non-2xx  ",
            color="#E65100",
            fontcolor="#E65100",
            penwidth=1.5
        ];

        on_success -> done [penwidth=1.5];
        on_failure -> check_threshold [penwidth=1.5];

        check_threshold -> permanent_skip [
            label="  No (permanent)  ",
            color="#C62828",
            fontcolor="#C62828",
            penwidth=1.5
        ];
        check_threshold -> degraded [
            label="  Yes (transient)  ",
            color="#F57F17",
            fontcolor="#F57F17",
            penwidth=2
        ];

        degraded -> sleep_backoff [penwidth=2, color="#F57F17"];
        sleep_backoff -> post [
            label="  retry same event  ",
            color="#F57F17",
            fontcolor="#F57F17",
            penwidth=2,
            constraint=false
        ];

        permanent_skip -> done [penwidth=1.5, color="#C62828"];
    }

    subgraph cluster_lifecycle {
        label="Client Lifecycle (_client field on LoggingHandler)";
        style=filled;
        fillcolor="#F9FBE7";
        color="#C5CAE9";
        fontsize=12;
        fontname="Helvetica Bold";

        node [shape=box, style="rounded,filled", penwidth=1.5];

        lc_init [
            label="__init__\n─────────────────────\nself._client = None\nself._dispatch_worker_task = None\nbounded queue allocated",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        lc_lazy [
            label="first dequeued dispatch\n─────────────────────\n_client = httpx.AsyncClient(...)\nTCP connection established",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        lc_reuse [
            label="subsequent dequeued dispatches\n─────────────────────\nexisting _client reused\nsingle keep-alive connection\n(no task fanout)",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        lc_close [
            label="close()\n─────────────────────\nwait briefly for queue drain\ncancel worker\n_client.aclose()\n(graceful TCP teardown)",
            fillcolor="#FFF3E0",
            color="#E65100"
        ];

        lc_init -> lc_lazy [
            label="  first dequeued dispatch  ",
            color="#2E7D32",
            fontcolor="#2E7D32",
            penwidth=1.5
        ];
        lc_lazy -> lc_reuse [
            label="  all subsequent dispatches  ",
            color="#00838F",
            fontcolor="#00838F",
            penwidth=1.5
        ];
        lc_reuse -> lc_close [
            label="  hook cleanup  ",
            color="#E65100",
            fontcolor="#E65100",
            penwidth=1.5
        ];
    }

    create_client -> lc_lazy [
        style=dotted,
        color="#2E7D32",
        arrowhead=vee,
        penwidth=1.5,
        label="  lazy init  ",
        constraint=false
    ];
    post -> lc_reuse [
        style=dotted,
        color="#00838F",
        arrowhead=vee,
        penwidth=1.5,
        label="  reuses  ",
        constraint=false
    ];
}
