// LoggingHandler — Event Processing Flow
// Context-Intelligence Bundle
//
// Shows how LoggingHandler processes each event: session_id gating,
// event_type branching, and disk I/O for session lifecycle events.
//
// Render: dot -Tsvg logging-handler-flow.dot -o logging-handler-flow.svg

digraph LoggingHandlerFlow {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    nodesep=0.7;
    ranksep=0.9;
    pad=0.5;

    // ─── Global defaults ─────────────────────────────────────────────
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // ─── Entry ───────────────────────────────────────────────────────
    node [shape=box, style="rounded,filled", penwidth=2];

    event_arrives [
        label="event_arrives\n───────────────────\nLoggingHandler.__call__\n(event_name, data)",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    // ─── Decision: session_id present? ───────────────────────────────
    node [shape=diamond, style=filled, penwidth=2];

    check_session_id [
        label="session_id\npresent?",
        fillcolor="#FFEBEE",
        color="#C62828",
        fontcolor="#C62828"
    ];

    // ─── Skip path ───────────────────────────────────────────────────
    node [shape=box, style="rounded,filled", penwidth=2];

    skip [
        label="skip\n───────────────────\nNo session context.\nReturn HookResult(continue)",
        fillcolor="#EEEEEE",
        color="#757575"
    ];

    // ─── Decision: event_type ────────────────────────────────────────
    node [shape=diamond, style=filled, penwidth=2];

    check_event_type [
        label="event_type?",
        fillcolor="#FFF8E1",
        color="#F57F17",
        fontcolor="#F57F17"
    ];

    // ─── Session init (start/fork) ───────────────────────────────────
    node [shape=box, style="rounded,filled", penwidth=2];

    session_init [
        label="session_init\n───────────────────\nTriggered by:\nsession:start / session:fork\n\n1. mkdir session dir\n2. Write metadata.json\n3. Create events.jsonl\n4. Append event",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    // ─── Session end ─────────────────────────────────────────────────
    session_end [
        label="session_end\n───────────────────\nTriggered by:\nsession:end\n\n1. Append to events.jsonl\n2. Update metadata.json\n   (end_time, status)",
        fillcolor="#FFF3E0",
        color="#E65100"
    ];

    // ─── Regular event ───────────────────────────────────────────────
    regular [
        label="regular\n───────────────────\nAll other event types\n\n1. Append to events.jsonl",
        fillcolor="#F3E5F5",
        color="#6A1B9A"
    ];

    // ─── Return ──────────────────────────────────────────────────────
    return_result [
        label="return HookResult(continue)\n───────────────────\nEvent processed.\nPipeline continues.",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    // ─── Storage nodes (folder shapes) ───────────────────────────────
    node [shape=folder, style=filled, penwidth=1.5];

    storage_session_dir [
        label="~/.amplifier/projects/\n{slug}/sessions/{id}/",
        fillcolor="#ECEFF1",
        color="#546E7A"
    ];

    storage_metadata [
        label="metadata.json",
        fillcolor="#ECEFF1",
        color="#546E7A"
    ];

    storage_events [
        label="events.jsonl",
        fillcolor="#ECEFF1",
        color="#546E7A"
    ];

    // ═══════════════════════════════════════════════════════════════════
    // ─── Transition edges ─────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    event_arrives -> check_session_id [
        penwidth=2
    ];

    check_session_id -> skip [
        label="  NO  ",
        color="#757575",
        fontcolor="#757575",
        penwidth=1.5
    ];

    check_session_id -> check_event_type [
        label="  YES  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2
    ];

    check_event_type -> session_init [
        label="  start / fork  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=1.5
    ];

    check_event_type -> session_end [
        label="  end  ",
        color="#E65100",
        fontcolor="#E65100",
        penwidth=1.5
    ];

    check_event_type -> regular [
        label="  other  ",
        color="#6A1B9A",
        fontcolor="#6A1B9A",
        penwidth=1.5
    ];

    session_init -> return_result [penwidth=1.5];
    session_end -> return_result [penwidth=1.5];
    regular -> return_result [penwidth=1.5];
    skip -> return_result [penwidth=1.5, style=dashed, color=grey];

    // ─── Storage associations ────────────────────────────────────────
    session_init -> storage_session_dir [
        style=dotted, color="#546E7A", arrowhead=vee,
        label="  mkdir  ", constraint=false
    ];

    session_init -> storage_metadata [
        style=dotted, color="#546E7A", arrowhead=vee,
        label="  write  "
    ];

    session_init -> storage_events [
        style=dotted, color="#546E7A", arrowhead=vee,
        label="  create + append  "
    ];

    session_end -> storage_events [
        style=dotted, color="#546E7A", arrowhead=vee,
        label="  append  "
    ];

    session_end -> storage_metadata [
        style=dotted, color="#546E7A", arrowhead=vee,
        label="  update  "
    ];

    regular -> storage_events [
        style=dotted, color="#546E7A", arrowhead=vee,
        label="  append  "
    ];
}
