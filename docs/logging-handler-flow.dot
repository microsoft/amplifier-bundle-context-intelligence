// LoggingHandler — Complete Event Processing Flow
// Context-Intelligence Bundle
//
// Shows both paths: local JSONL persistence (always-on) and
// bounded best-effort HTTP dispatch to the Context Intelligence server.
// Includes payload shapes for both the local record and the server POST.
//
// Render: dot -Tsvg logging-handler-flow.dot -o logging-handler-flow.svg

digraph LoggingHandlerFlow {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    nodesep=0.7;
    ranksep=0.9;
    pad=0.5;

    // ─── Global defaults ─────────────────────────────────────────────
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // ═══════════════════════════════════════════════════════════════════
    // MOUNT PHASE — what happens at hook registration time
    // ═══════════════════════════════════════════════════════════════════

    subgraph cluster_mount {
        label="mount(coordinator, config)";
        style=filled;
        fillcolor="#FAFAFA";
        color="#B0BEC5";
        fontsize=12;
        fontname="Helvetica Bold";

        node [shape=box, style="rounded,filled", penwidth=1.5];

        mount_start [
            label="mount() called\n───────────────────\ncoordinator + config dict\n(env vars already expanded\nby Amplifier CLI)",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        mount_resolver [
            label="HookConfigResolver(config, coordinator)\n───────────────────\nLazy fallback chains for:\nproject_slug, base_path,\nworkspace, server_url, log_level",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        mount_discover [
            label="_discover_events(coordinator)\n───────────────────\nALL_EVENTS (amplifier_core.events)\n∪ contributions (observability.events)\n∪ capability (observability.events)\n→ minus exclude_events (fnmatch)",
            fillcolor="#FFF8E1",
            color="#F57F17"
        ];

        mount_register [
            label="Register LoggingHandler\n───────────────────\ncoordinator.hooks.register(\n  event, handler, priority=100\n)\nfor each active event",
            fillcolor="#F3E5F5",
            color="#6A1B9A"
        ];

        mount_done [
            label="return cleanup()\n───────────────────\nCleanup unregisters\nall hook handlers",
            fillcolor="#ECEFF1",
            color="#546E7A"
        ];

        mount_start -> mount_resolver;
        mount_resolver -> mount_discover;
        mount_discover -> mount_register;
        mount_register -> mount_done;
    }

    // ═══════════════════════════════════════════════════════════════════
    // EVENT PHASE — what happens when each event fires
    // ═══════════════════════════════════════════════════════════════════

    subgraph cluster_event {
        label="LoggingHandler.__call__(event, data)  — per event";
        style=filled;
        fillcolor="#FAFAFA";
        color="#B0BEC5";
        fontsize=12;
        fontname="Helvetica Bold";

        // ─── Entry ───────────────────────────────────────────────────
        node [shape=box, style="rounded,filled", penwidth=2];

        event_arrives [
            label="event arrives\n───────────────────\nLoggingHandler.__call__\n(event_name, data)",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        // ─── Decision: session_id present? ───────────────────────────
        node [shape=diamond, style=filled, penwidth=2];

        check_session_id [
            label="session_id\npresent?",
            fillcolor="#FFEBEE",
            color="#C62828",
            fontcolor="#C62828"
        ];

        // ─── Skip path ──────────────────────────────────────────────
        node [shape=box, style="rounded,filled", penwidth=2];

        skip [
            label="skip\n───────────────────\nNo session context.\nReturn HookResult(continue)",
            fillcolor="#EEEEEE",
            color="#757575"
        ];

        // ─── Lazy metadata init ─────────────────────────────────────
        node [shape=diamond, style=filled, penwidth=2];
        check_first_event [
            label="first event\nfor this\nsession?",
            fillcolor="#FFF8E1",
            color="#F57F17",
            fontcolor="#F57F17"
        ];

        node [shape=box, style="rounded,filled", penwidth=1.5];
        ensure_metadata [
            label="_ensure_metadata()\n───────────────────\nmkdir session_dir\nWrite initial metadata.json:\n{\n  format: 'context-intelligence',\n  version: '1.0.0',\n  session_id, parent_id,\n  started_at, status: 'running',\n  working_dir\n}",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        // ─── Decision: event_type ───────────────────────────────────
        node [shape=diamond, style=filled, penwidth=2];

        check_event_type [
            label="event_type?",
            fillcolor="#FFF8E1",
            color="#F57F17",
            fontcolor="#F57F17"
        ];

        // ─── Session init (start/fork) ──────────────────────────────
        node [shape=box, style="rounded,filled", penwidth=2];

        session_init [
            label="session:start / session:fork\n───────────────────\n_enrich_metadata_from_session_init()\n  Overwrites: parent_id, started_at,\n    working_dir\n  Adds optional: agent_name,\n    parallel_group_id, recipe_name,\n    recipe_step\n  Reasserts: format, version",
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];

        // ─── Session end ────────────────────────────────────────────
        session_end [
            label="session:end / execution:end\n───────────────────\n_finalize_metadata()\n  Sets: status, ended_at\n  Reasserts: format, version",
            fillcolor="#FFF3E0",
            color="#E65100"
        ];

        // ─── Regular event ──────────────────────────────────────────
        regular [
            label="all other events\n───────────────────\n(no metadata changes)",
            fillcolor="#F3E5F5",
            color="#6A1B9A"
        ];

        // ─── JSONL append — always happens ──────────────────────────
        append_event [
            label="_append_event()\n───────────────────\nAppend to events.jsonl",
            fillcolor="#E8EAF6",
            color="#283593"
        ];

        // ─── Decision: server configured? ───────────────────────────
        node [shape=diamond, style=filled, penwidth=2];
        check_server [
            label="server_url\nconfigured?",
            fillcolor="#FFEBEE",
            color="#C62828",
            fontcolor="#C62828"
        ];

        // ─── Server dispatch ────────────────────────────────────────
        node [shape=box, style="rounded,filled", penwidth=2];
        dispatch [
            label="_enqueue_dispatch()\n───────────────────\nput_nowait(event, sanitized data)\ninto bounded queue\nspawn shared worker if needed\nqueue full => disable dispatch\nlocal JSONL remains durable",
            fillcolor="#E0F7FA",
            color="#00838F"
        ];

        // ─── Return ─────────────────────────────────────────────────
        return_result [
            label="return HookResult(continue)\n───────────────────\nEvent processed.\nPipeline continues.",
            fillcolor="#E3F2FD",
            color="#1565C0"
        ];

        // ─── Edges ──────────────────────────────────────────────────
        event_arrives -> check_session_id [penwidth=2];

        check_session_id -> skip [
            label="  NO  ", color="#757575", fontcolor="#757575", penwidth=1.5
        ];

        check_session_id -> check_first_event [
            label="  YES  ", color="#2E7D32", fontcolor="#2E7D32", penwidth=2
        ];

        check_first_event -> ensure_metadata [
            label="  YES  ", color="#2E7D32", fontcolor="#2E7D32", penwidth=1.5
        ];
        check_first_event -> check_event_type [
            label="  NO  ", color="#757575", fontcolor="#757575", penwidth=1.5
        ];
        ensure_metadata -> check_event_type [penwidth=1.5];

        check_event_type -> session_init [
            label="  start / fork  ", color="#2E7D32", fontcolor="#2E7D32", penwidth=1.5
        ];
        check_event_type -> session_end [
            label="  end  ", color="#E65100", fontcolor="#E65100", penwidth=1.5
        ];
        check_event_type -> regular [
            label="  other  ", color="#6A1B9A", fontcolor="#6A1B9A", penwidth=1.5
        ];

        session_init -> append_event [penwidth=1.5];
        session_end -> append_event [penwidth=1.5];
        regular -> append_event [penwidth=1.5];

        append_event -> check_server [penwidth=1.5];

        check_server -> dispatch [
            label="  YES  ", color="#00838F", fontcolor="#00838F", penwidth=1.5
        ];
        check_server -> return_result [
            label="  NO  ", color="#757575", fontcolor="#757575", penwidth=1.5
        ];

        dispatch -> return_result [penwidth=1.5];
        skip -> return_result [penwidth=1.5, style=dashed, color=grey];
    }

    // ═══════════════════════════════════════════════════════════════════
    // PAYLOAD SHAPES — what data looks like at each stage
    // ═══════════════════════════════════════════════════════════════════

    subgraph cluster_payloads {
        label="Payload Shapes";
        style=filled;
        fillcolor="#FAFAFA";
        color="#B0BEC5";
        fontsize=12;
        fontname="Helvetica Bold";

        node [shape=note, style=filled, penwidth=1.5, fontsize=10];

        payload_jsonl [
            label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD ALIGN="LEFT"><B>events.jsonl record</B> (one per line)</TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">{</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "event": "tool:post",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "timestamp": "2026-03-15T...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "data": {</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "session_id": "abc-123",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "tool_name": "bash",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "tool_call_id": "tc_01",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    ... full event data ...</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  }</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">}</FONT></TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT">data is sanitized: Pydantic→dict,</TD></TR>
                <TR><TD ALIGN="LEFT">set→sorted list, fallback→str()</TD></TR>
            </TABLE>>,
            fillcolor="#E8EAF6",
            color="#283593"
        ];

        payload_server [
            label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD ALIGN="LEFT"><B>POST {server_url}/events</B></TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">{</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "event": "tool:post",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "workspace": "my-project",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "idempotency_key": "aci-event-v1:...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "data": {</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "session_id": "abc-123",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "tool_name": "bash",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "tool_call_id": "tc_01",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    "timestamp": "2026-03-...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">    ... full event data ...</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  }</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">}</FONT></TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT">workspace scopes data on server</TD></TR>
                <TR><TD ALIGN="LEFT">data is sanitized before enqueue</TD></TR>
                <TR><TD ALIGN="LEFT">single worker serializes POSTs</TD></TR>
                <TR><TD ALIGN="LEFT">deterministic key supports server dedup</TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT">httpx.AsyncClient(connect=0.5s, write=10s, read=3s)</TD></TR>
                <TR><TD ALIGN="LEFT">bounded queue: failure/full => disable dispatch</TD></TR>
            </TABLE>>,
            fillcolor="#E0F7FA",
            color="#00838F"
        ];

        payload_metadata [
            label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                <TR><TD ALIGN="LEFT"><B>metadata.json</B></TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">{</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "format": "context-intelligence",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "version": "1.0.0",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "session_id": "abc-123",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "parent_id": "" | "parent-id",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "started_at": "2026-03-...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "ended_at": "2026-03-...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "status": "running"|"completed",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "working_dir": "/home/...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "agent_name": "explorer",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "recipe_name": "...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "recipe_step": "...",</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">  "parallel_group_id": "..."</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Courier">}</FONT></TD></TR>
                <TR><TD ALIGN="LEFT">───────────────────────────</TD></TR>
                <TR><TD ALIGN="LEFT">Required: format, version, session_id,</TD></TR>
                <TR><TD ALIGN="LEFT">  parent_id, started_at, status, working_dir</TD></TR>
                <TR><TD ALIGN="LEFT">Optional: agent_name, recipe_name,</TD></TR>
                <TR><TD ALIGN="LEFT">  recipe_step, parallel_group_id</TD></TR>
                <TR><TD ALIGN="LEFT">No nulls — absent fields omitted</TD></TR>
                <TR><TD ALIGN="LEFT">parent_id="" for root sessions</TD></TR>
            </TABLE>>,
            fillcolor="#E8F5E9",
            color="#2E7D32"
        ];
    }

    // ─── Cross-cluster edges from event flow to payloads ────────────
    append_event -> payload_jsonl [
        style=dotted, color="#283593", arrowhead=vee,
        label="  writes  ", constraint=false
    ];
    dispatch -> payload_server [
        style=dotted, color="#00838F", arrowhead=vee,
        label="  POSTs  ", constraint=false
    ];
    ensure_metadata -> payload_metadata [
        style=dotted, color="#2E7D32", arrowhead=vee,
        label="  creates  ", constraint=false
    ];
    session_init -> payload_metadata [
        style=dotted, color="#2E7D32", arrowhead=vee,
        label="  enriches  ", constraint=false
    ];
    session_end -> payload_metadata [
        style=dotted, color="#E65100", arrowhead=vee,
        label="  finalizes  ", constraint=false
    ];

    // ─── Mount to event connection ──────────────────────────────────
    mount_done -> event_arrives [
        style=dashed, color="#B0BEC5", penwidth=1.5,
        label="  events fire during session  ",
        ltail=cluster_mount, lhead=cluster_event
    ];
}
