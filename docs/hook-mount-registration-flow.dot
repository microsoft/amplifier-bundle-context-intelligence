// Hook Mount and Registration Flow — State Machine Diagram
// Context-Intelligence Bundle
//
// Render: dot -Tsvg hook-mount-registration-flow.dot -o hook-mount-registration-flow.svg
//         dot -Tpng hook-mount-registration-flow.dot -o hook-mount-registration-flow.png

digraph HookMountFlow {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=12;
    compound=true;
    newrank=true;
    nodesep=0.8;
    ranksep=1.0;
    pad=0.5;

    // ─── Global defaults ───────────────────────────────────────────────
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // ─── State nodes (gradient from light to dark as flow advances) ───
    node [shape=box, style="rounded,filled", penwidth=2];

    INIT [
        label="INIT\n─────────────────\nHook instantiated.\nNo state exists yet.",
        fillcolor="#E3F2FD",
        color="#1565C0"
    ];

    STATE_CREATED [
        label="STATE_CREATED\n─────────────────────────\nHookStateService ready.\nGraphState + HookConfig\ninitialized.",
        fillcolor="#BBDEFB",
        color="#1565C0"
    ];

    HANDLERS_INSTANTIATED [
        label="HANDLERS_INSTANTIATED\n──────────────────────────────\nAll 7 handlers constructed.\nclaimed_events set computed\nfrom 6 entity handlers.",
        fillcolor="#90CAF9",
        color="#1565C0"
    ];

    EVENTS_DISCOVERED [
        label="EVENTS_DISCOVERED\n────────────────────────────\nremaining_events known.\n(discovered − excluded)",
        fillcolor="#64B5F6",
        color="#0D47A1",
        fontcolor="#0D47A1"
    ];

    SPECIFIC_REGISTERED [
        label="SPECIFIC_REGISTERED\n──────────────────────────────\nAll 6 entity handlers registered\nfor their claimed events.",
        fillcolor="#42A5F5",
        color="#0D47A1",
        fontcolor="white"
    ];

    READY [
        label="READY\n──────────────────────────────\nHook fully mounted.\nEvery discovered non-excluded\nevent has exactly one handler.",
        fillcolor="#1E88E5",
        color="#0D47A1",
        fontcolor="white"
    ];

    // ─── Component records (side annotations) ─────────────────────────
    node [shape=record, style=filled, penwidth=1];

    HookStateService [
        label="{HookStateService|{graph: GraphState|config: HookConfig}}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    GraphState [
        label="{GraphState|get_node(id, labels)\lget_edge(source, target, type)\lupsert_node(id, labels, props)\lupsert_edge(source, target, type, props)\l|Per-Session Tracking:\lcurrent Session\lcurrent OrchestratorRun\lcurrent Step\lstep counter\lpending delegate correlation\l}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    HookConfig [
        label="{HookConfig|exclusion_filter: set[str]\lverbosity: str\lconnection_params: dict\l}",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    // ─── Handler set record ───────────────────────────────────────────
    Handlers [
        label="{Entity Handlers (6)|SessionHandler → :Session\l|OrchestratorRunHandler → :OrchestratorRun, :Step:PromptStep\l|StepHandler → :Step:AssistantStep\l|RecipeStepHandler → :Step:RecipeStep\l|ToolExecutionHandler → :ToolExecution\l|EventHandler → :Event:\\{FullScope\\}\l}|{DefaultHandler|handled_events: \\{\\} (empty at construction)\lReceives unclaimed events at Phase 5\lDerives :Event:\\{DerivedFullScope\\} labels\l}",
        fillcolor="#FFF3E0",
        color="#E65100"
    ];

    // ─── Discovery channels ───────────────────────────────────────────
    node [shape=parallelogram, style=filled, penwidth=1.5];

    ChannelCanonical [
        label="collect_contributions\n(\"observability.events\")\nCanonical Channel",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    ChannelLegacy [
        label="get_capability\n(\"observability.events\")\nLegacy Channel",
        fillcolor="#FFF8E1",
        color="#F57F17"
    ];

    // ─── Exclusion filter (decision point) ────────────────────────────
    node [shape=diamond, style=filled, penwidth=2];

    ExclusionFilter [
        label="Exclusion\nFilter",
        fillcolor="#FFEBEE",
        color="#C62828",
        fontcolor="#C62828"
    ];

    // ─── Protocol note ────────────────────────────────────────────────
    node [shape=note, style=filled, penwidth=1];

    ProtocolNote [
        label="EventHandler Protocol\n──────────────────────\nhandled_events: set[str]\n__call__(event, data) → HookResult\nservices: HookStateService\n──────────────────────\nRuntime-checkable.\nNo inheritance.",
        fillcolor="#F3E5F5",
        color="#6A1B9A"
    ];

    InvariantNote [
        label="Key Invariant\n──────────────────────────\nEvery discovered non-excluded\nevent gets exactly ONE handler.\nNo duplicates. No gaps.",
        fillcolor="#FCE4EC",
        color="#AD1457"
    ];

    // ═══════════════════════════════════════════════════════════════════
    // ─── Transition edges (main flow) ─────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════

    // Phase 1: INIT → STATE_CREATED
    INIT -> STATE_CREATED [
        label="  Create HookStateService\n  (GraphState + HookConfig)  ",
        color="#1565C0",
        fontcolor="#1565C0",
        penwidth=2
    ];

    // Phase 2: STATE_CREATED → HANDLERS_INSTANTIATED
    STATE_CREATED -> HANDLERS_INSTANTIATED [
        label="  Instantiate 7 handlers\n  (each receives HookStateService)\n  Aggregate claimed_events  ",
        color="#1565C0",
        fontcolor="#1565C0",
        penwidth=2
    ];

    // Phase 3: HANDLERS_INSTANTIATED → discovery channels → filter → EVENTS_DISCOVERED
    HANDLERS_INSTANTIATED -> ChannelCanonical [
        label="  Query channel 1  ",
        color="#F57F17",
        fontcolor="#F57F17",
        penwidth=1.5,
        style=dashed
    ];

    HANDLERS_INSTANTIATED -> ChannelLegacy [
        label="  Query channel 2  ",
        color="#F57F17",
        fontcolor="#F57F17",
        penwidth=1.5,
        style=dashed
    ];

    ChannelCanonical -> ExclusionFilter [
        label="  events  ",
        color="#F57F17",
        fontcolor="#F57F17",
        penwidth=1.5
    ];

    ChannelLegacy -> ExclusionFilter [
        label="  events  ",
        color="#F57F17",
        fontcolor="#F57F17",
        penwidth=1.5
    ];

    ExclusionFilter -> EVENTS_DISCOVERED [
        label="  remaining = discovered − excluded\n  (filter applied ONCE)  ",
        color="#C62828",
        fontcolor="#C62828",
        penwidth=2
    ];

    // Phase 4: EVENTS_DISCOVERED → SPECIFIC_REGISTERED
    EVENTS_DISCOVERED -> SPECIFIC_REGISTERED [
        label="  For each entity handler:\n    register(event, handler)\n  for events in handler.handled_events\n  ∩ remaining_events  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2
    ];

    // Phase 5: SPECIFIC_REGISTERED → READY
    SPECIFIC_REGISTERED -> READY [
        label="  unclaimed = remaining − claimed\n  For each unclaimed event:\n    register(event, default_handler)  ",
        color="#2E7D32",
        fontcolor="#2E7D32",
        penwidth=2
    ];

    // ─── Component association edges ──────────────────────────────────

    HookStateService -> GraphState [
        style=dashed,
        color="#2E7D32",
        arrowhead=vee,
        label="  contains  "
    ];

    HookStateService -> HookConfig [
        style=dashed,
        color="#2E7D32",
        arrowhead=vee,
        label="  contains  "
    ];

    INIT -> HookStateService [
        style=dotted,
        color="#66BB6A",
        arrowhead=none,
        constraint=false,
        label="  created at Phase 1  "
    ];

    STATE_CREATED -> Handlers [
        style=dotted,
        color="#FF9800",
        arrowhead=none,
        constraint=false,
        label="  created at Phase 2  "
    ];

    Handlers -> ProtocolNote [
        style=dotted,
        color="#9C27B0",
        arrowhead=none,
        constraint=false,
        label="  all conform to  "
    ];

    READY -> InvariantNote [
        style=dotted,
        color="#AD1457",
        arrowhead=none,
        constraint=false
    ];

    HookConfig -> ExclusionFilter [
        style=dashed,
        color="#C62828",
        arrowhead=vee,
        constraint=false,
        label="  provides exclusion set  "
    ];

    // ─── Layout hints ─────────────────────────────────────────────────

    // Main flow is vertical
    {rank=same; INIT}
    {rank=same; STATE_CREATED; HookStateService}
    {rank=same; HANDLERS_INSTANTIATED; Handlers}
    {rank=same; ChannelCanonical; ChannelLegacy; ExclusionFilter}
    {rank=same; EVENTS_DISCOVERED; ProtocolNote}
    {rank=same; SPECIFIC_REGISTERED}
    {rank=same; READY; InvariantNote}
    {rank=same; GraphState; HookConfig}
}
